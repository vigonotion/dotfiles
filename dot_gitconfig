[push]
	autoSetupRemote = true

[alias]
    p    = push
    s    = status -sb
    co   = checkout
    cob  = checkout -b
    sw   = switch
    swc  = switch -c
    ac   = !git add -A && git commit -m
    acp  = !git add -A && git commit -m && git push
    oops = commit --amend --no-edit
    undo = reset HEAD~1 --mixed
